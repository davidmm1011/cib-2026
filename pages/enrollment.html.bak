<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="format-detection" content="telephone=no">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Titulo -->
    <title>Inscripciones | 4º Congreso Internacional de Biotecnología 2026</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="../assets/favicon.png">
    <link rel="apple-touch-icon" href="../assets/favicon.png">

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="../css/styles.css">
</head>

<body class="tail-container bg-[#F8F5F0] text-[#1F2937] overflow-x-hidden">

    <!-- NAVBAR -->
    <nav class="bg-white/95 backdrop-blur-md border-b border-[#E5D9C8] fixed w-full z-50 transition-all duration-300">
        <div class="max-w-screen-2xl mx-auto">
            <div class="px-4 sm:px-6 lg:px-8 py-4 flex items-center justify-between">
                
                <!-- Logo -->
                <div class="flex items-center gap-x-2">
                    <div>
                        <a href="https://boliviainnova.com" class="heading-font text-2xl sm:text-3xl font-bold tracking-tighter text-[#0A3D4A]">BOLIVIA</a>
                        <a href="https://boliviainnova.com" class="heading-font text-2xl sm:text-3xl font-bold tracking-tighter text-[#00B4A6]">INNOVA</a>
                    </div>
                </div>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-x-8 text-sm font-medium">
                    <a href="../index.html#nosotros" onclick="navigateToSection('nosotros')" class="nav-link text-[#1F2937]">Quiénes somos</a>
                    <a href="../index.html#trabajo" onclick="navigateToSection('trabajo')" class="nav-link text-[#1F2937]">Qué hacemos</a>
                    <a href="../index.html#areas" onclick="navigateToSection('areas')" class="nav-link text-[#1F2937]">Áreas temáticas</a>
                    <a href="../index.html#ponentes" onclick="navigateToSection('ponentes')" class="nav-link text-[#1F2937] hidden">Ponentes</a>
                    <a href="../index.html#programa" onclick="navigateToSection('programa')" class="nav-link text-[#1F2937] hidden">Programa</a>
                </div>

                <!-- Botones lado derecho -->
                <div class="flex items-center gap-x-3">
                    <!-- Menú hamburguesa -->
                    <button onclick="toggleMobileMenu()" 
                            class="md:hidden w-10 h-10 flex items-center justify-center text-2xl text-[#0A3D4A]">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-white border-t">
            <div class="px-8 py-8 flex flex-col gap-y-6 text-lg">
                <a href="../index.html#nosotros" onclick="navigateToSection('nosotros');toggleMobileMenu()" class="nav-link">Quienes somos</a>
                <a href="../index.html#trabajo" onclick="navigateToSection('trabajo');toggleMobileMenu()" class="nav-link">Qué hacemos</a>
                <a href="../index.html#areas" onclick="navigateToSection('areas');toggleMobileMenu()" class="nav-link">Áreas temáticas</a>
                <a href="../index.html#ponentes" onclick="navigateToSection('ponentes');toggleMobileMenu()" class="nav-link hidden">Ponentes</a>
                <a href="../index.html#programa" onclick="navigateToSection('programa');toggleMobileMenu()" class="nav-link hidden">Programa</a>
            </div>
        </div>
    </nav>

    <!-- HEADER -->
    <header class="pt-32 pb-12 bg-[#0A3D4A] text-white">
        <div class="max-w-screen-2xl mx-auto px-6 md:px-8">
            <div class="max-w-3xl">
                <div class="inline-flex items-center gap-x-2 bg-white/10 backdrop-blur-md hover:bg-[#214854] text-white text-sm font-medium px-5 py-2 rounded-3xl mb-6">
                    <div class="w-2 h-2 bg-[#00B4A6] rounded-full animate-pulse"></div>
                    <p class="text-xs sm:text-sm">10 — 12 de Diciembre 2026 • Santa Cruz, Bolivia</p>
                </div>
                <h1 class="heading-font text-5xl md:text-6xl font-bold leading-none mb-6">
                    Inscripciones
                </h1>
                <p class="text-xl text-white/80 max-w-xl">
                    Completa tu registro al Congreso Internacional de Biotecnología 2026. 
                    Early Bird disponible hasta el 30 de septiembre.
                </p>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="py-16 md:py-20">
        <div class="max-w-screen-2xl mx-auto px-6 md:px-8">
            
            <!-- Información rápida de precios -->
            <div class="grid md:grid-cols-3 gap-6 mb-16">
                <div class="bg-white rounded-3xl p-8 border border-[#E5D9C8]">
                    <div class="text-sm uppercase tracking-widest text-[#64748B] mb-2">Estudiantes</div>
                    <div class="text-3xl font-semibold text-[#0A3D4A]">Bs. 250</div>
                    <div class="text-sm text-[#64748B] mt-1">Presencial · Early Bird Bs. 200</div>
                </div>
                <div class="bg-white rounded-3xl p-8 border border-[#E5D9C8]">
                    <div class="text-sm uppercase tracking-widest text-[#64748B] mb-2">Profesionales</div>
                    <div class="text-3xl font-semibold text-[#0A3D4A]">Bs. 350</div>
                    <div class="text-sm text-[#64748B] mt-1">Presencial · Early Bird Bs. 280</div>
                </div>
                <div class="bg-white rounded-3xl p-8 border border-[#E5D9C8]">
                    <div class="text-sm uppercase tracking-widest text-[#64748B] mb-2">Modalidad Virtual</div>
                    <div class="text-3xl font-semibold text-[#0A3D4A]">Desde Bs. 120</div>
                    <div class="text-sm text-[#64748B] mt-1">Acceso a grabaciones incluidas</div>
                </div>
            </div>

            <!-- Espacio para embed del formulario Jotform -->
            <div class="max-w-4xl mx-auto">
                <div class="mb-8 text-center">
                    <h2 class="heading-font text-3xl md:text-4xl font-bold text-[#0A3D4A] mb-3">Formulario de inscripción</h2>
                    <p class="text-[#64748B]">Completa los datos a continuación para asegurar tu lugar</p>
                </div>

                <!-- CONTENEDOR PARA EMBED DE JOTFORM -->
                <div class="form-container p-4 md:p-8 bg-white rounded-3xl border border-[#E5D9C8] shadow-md">
                    <!-- 
                        INSTRUCCIONES:
                        1. Ve a tu formulario en Jotform
                        2. Copia el código de embed (iframe)
                        3. Reemplaza TODO el contenido de este div con el código de Jotform
                    -->
                    
                    
                    <iframe
                    id="JotFormIFrame-261906962913061"
                    title="Registro al Congreso Boliviano de Biotecnología"
                    onload="window.parent.scrollTo(0,0)"
                    allowtransparency="true"
                    allow="geolocation; microphone; camera; fullscreen; payment"
                    src="https://form.jotform.com/261906962913061"
                    frameborder="0"
                    style="min-width:100%;max-width:100%;height:539px;border:none;"
                    scrolling="no"
                    >
                    </iframe>
                    <script src='https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js'></script>
                    <script>window.jotformEmbedHandler("iframe[id='JotFormIFrame-261906962913061']", "https://form.jotform.com/")</script>
                    

                    <!-- EJEMPLO de cómo quedaría (comentado):
                    <iframe
                        id="JotFormIFrame-261906962913061"
                        title="Formulario de Inscripción"
                        onload="window.parent.scrollTo(0,0)"
                        allowtransparency="true"
                        allowfullscreen="true"
                        allow="geolocation; microphone; camera"
                        src="https://form.jotform.com/261906962913061"
                        frameborder="0"
                        style="min-width:100%;max-width:100%;height:900px;border:none;"
                        scrolling="no"
                    >
                    </iframe>
                    -->
                </div>

                <p class="text-center text-sm text-[#64748B] mt-8">
                    ¿Tienes problemas con el formulario? Escríbenos a 
                    <a href="mailto:congresoboliviainnova@gmail.com" class="text-[#00B4A6] hover:underline">
                        congresoboliviainnova@gmail.com
                    </a>
                </p>
            </div>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="bg-[#0A3D4A] text-white">
        <div class="max-w-screen-2xl mx-auto px-6 md:px-8 pt-16 pb-10">
            <div class="grid md:grid-cols-12 gap-y-12">
                <div class="md:col-span-5">
                    <div class="heading-font text-3xl font-bold tracking-tighter mb-6">BOLIVIA INNOVA</div>
                    <p class="max-w-xs text-white/70 text-sm">
                        Congreso Internacional de Biotecnología<br>
                        Santa Cruz, Bolivia • 10 al 12 de diciembre 2026
                    </p>
                </div>
                
                <div class="md:col-span-3">
                    <div class="uppercase text-xs tracking-widest mb-5 text-white/50">Navegación</div>
                    <div class="space-y-3 text-sm">
                        <a href="index.html#nosotros" class="block hover:text-[#00B4A6]">Quiénes somos</a>
                        <a href="index.html#areas" class="block hover:text-[#00B4A6]">Áreas temáticas</a>
                        <a href="index.html#ponentes" class="block hover:text-[#00B4A6]">Ponentes</a>
                        <a href="index.html#programa" class="block hover:text-[#00B4A6]">Programa</a>
                    </div>
                </div>
                
                <div class="md:col-span-4">
                    <div class="uppercase text-xs tracking-widest mb-5 text-white/50">Contacto</div>
                    <div class="space-y-3 text-sm">
                        <a href="mailto:congresoboliviainnova@gmail.com" class="block hover:text-[#00B4A6]">
                            congresoboliviainnova@gmail.com
                        </a>
                        <div class="flex gap-x-6 text-2xl mt-6">
                            <a href="#" class="hover:text-[#00B4A6]"><i class="fa-brands fa-x-twitter"></i></a>
                            <a href="#" class="hover:text-[#00B4A6]"><i class="fa-brands fa-linkedin"></i></a>
                            <a href="#" class="hover:text-[#00B4A6]"><i class="fa-brands fa-instagram"></i></a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="border-t border-white/10 mt-16 pt-8 text-xs flex flex-col md:flex-row justify-between items-center text-white/40">
                <div>© Bolivia Innova — Congreso Internacional de Biotecnología 2026</div>
                <div class="mt-3 md:mt-0">Hecho con respeto por la ciencia y la naturaleza</div>
            </div>
        </div>
    </footer>

